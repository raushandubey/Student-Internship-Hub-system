APP_NAME="Student Internship Hub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

# Server Configuration
OCTANE_ENABLED=false

# Filesystem Configuration
# Default storage disk for file uploads (s3 for production, public for local development)
FILESYSTEM_DISK=s3

# AWS S3 Configuration
# Laravel Cloud auto-populates these credentials when S3 storage is attached
# For local development, obtain these from AWS IAM Console or use LocalStack

# AWS access key ID for S3 authentication
AWS_ACCESS_KEY_ID=

# AWS secret access key for S3 authentication
AWS_SECRET_ACCESS_KEY=

# AWS region where your S3 bucket is located (e.g., us-east-1, eu-west-1)
AWS_DEFAULT_REGION=us-east-1

# S3 bucket name for file storage
AWS_BUCKET=

# Optional: Custom S3 URL (useful for CloudFront CDN or custom domains)
AWS_URL=

# Optional: Custom S3 endpoint (useful for LocalStack or S3-compatible services)
AWS_ENDPOINT=

# Use path-style endpoint format (required for LocalStack, false for AWS S3)
AWS_USE_PATH_STYLE_ENDPOINT=false

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

LOG_CHANNEL=stack
LOG_LEVEL=error

MAIL_MAILER=log

OPENAI_API_KEY=
OPENAI_RESUME_MODEL=gpt-4o-mini
OPENAI_RESUME_ENDPOINT=https://api.openai.com/v1/chat/completions
ANTHROPIC_API_KEY=
ANTHROPIC_RESUME_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_RESUME_ENDPOINT=https://api.anthropic.com/v1/messages
OPENROUTER_API_KEY=
OPENROUTER_RESUME_MODEL=deepseek/deepseek-chat
OPENROUTER_RESUME_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# LaTeXLite — PDF rendering (https://latexlite.com/get-demo-key for a free demo key)
LATEXLITE_API_KEY=
LATEXLITE_API_URL=https://latexlite.com/v1/renders-sync
# Optional: timeouts (seconds), SSL verify (true|false|path/to/cacert.pem), retries
LATEXLITE_TIMEOUT=60
LATEXLITE_CONNECT_TIMEOUT=15
LATEXLITE_VERIFY_SSL=true
LATEXLITE_RETRY_TIMES=2
# Local Windows/XAMPP only if curl SSL fails: LATEXLITE_VERIFY_SSL=false
RESUME_OPTIMIZER_LIGHT_MODE=true
RESUME_OPTIMIZER_MIN_SCORE_DELTA=1
RESUME_OPTIMIZER_MIN_TEXT_DELTA=0.08
RESUME_OPTIMIZER_MAX_AI_SCORE_DELTA=8
RESUME_OPTIMIZER_MAX_ELITE_SCORE_GAIN=12

# Resume Intelligence API — secures n8n JD analysis webhook
RESUME_INTELLIGENCE_API_KEY=
N8N_WEBHOOK_URL=

# Production deploy checklist:
# php artisan config:clear && php artisan config:cache && php artisan route:cache
# Verify: GET /admin/debug-ai (or php artisan resume:diagnose-ai if registered)
# Required: at least one of OPENAI_API_KEY, ANTHROPIC_API_KEY, OPENROUTER_API_KEY + LATEXLITE_API_KEY
